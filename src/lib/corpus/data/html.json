    "tags": ["forms", "attributes"],
    "text": "<form novalidate>\n  <label for=\"target\">Target WPM</label>\n  <input\n    id=\"target\"\n    name=\"target\"\n    type=\"number\"\n    min=\"20\"\n    max=\"140\"\n    step=\"5\"\n    value=\"60\"\n    inputmode=\"numeric\"\n    aria-describedby=\"target-hint\"\n  />\n  <p id=\"target-hint\">Between 20 and 140 words per minute.</p>\n  <output name=\"result\" for=\"target\">60</output>\n</form>"
  },
