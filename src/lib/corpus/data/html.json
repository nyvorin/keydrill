    "lang": "html",
    "kind": "snippet",
    "difficulty": "medium",
    "tags": ["media", "attributes"],
    "text": "<picture>\n  <source srcset=\"/img/board.avif\" type=\"image/avif\" media=\"(min-width: 40rem)\" />\n  <source srcset=\"/img/board.webp\" type=\"image/webp\" />\n  <img src=\"/img/board.png\" alt=\"Layer map\" loading=\"lazy\" decoding=\"async\" />\n</picture>"
  },
  {
    "lang": "html",
    "kind": "snippet",
    "difficulty": "hard",
    "tags": ["tables", "semantic", "attributes"],
    "text": "<table class=\"stats\">\n  <caption>Layer-chord latency, last 7 days</caption>\n  <colgroup><col class=\"col-day\" /></colgroup>\n  <thead>\n    <tr>\n      <th scope=\"col\">Day</th>\n      <th scope=\"col\" abbr=\"Base\">Base ms</th>\n      <th scope=\"col\" abbr=\"Lower\">Lower ms</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th scope=\"row\">Mon</th>\n      <td>184</td>\n      <td>412</td>\n    </tr>\n  </tbody>\n  <tfoot>\n    <tr>\n      <th scope=\"row\">Median</th>\n      <td colspan=\"2\">298</td>\n    </tr>\n  </tfoot>\n</table>"
  },
