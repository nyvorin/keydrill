    "difficulty": "hard",
    "tags": ["forms", "attributes", "semantic"],
    "text": "<dialog id=\"snooze\" aria-labelledby=\"snooze-title\">\n  <form method=\"dialog\" class=\"snooze-form\">\n    <h2 id=\"snooze-title\">Remind me later</h2>\n    <menu>\n      <button value=\"30m\" autofocus>30 min</button>\n      <button value=\"1h\">1 hour</button>\n      <button value=\"6h\">6 hours</button>\n    </menu>\n  </form>\n</dialog>"
  },
